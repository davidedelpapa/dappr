use crate::utils::StyleStorage;
use lightningcss::rules::CssRule;
use lightningcss::stylesheet::{ParserOptions, PrinterOptions, StyleSheet};
use lightningcss::traits::ToCss;
use std::collections::HashMap;
use std::fs::{self, File};
use std::io::Write;
use std::path::{Path, PathBuf};

lazy_static::lazy_static! {
    static ref PICO_CSS: StyleStorage = StyleStorage::new(include_str!("assets/vendor/pico.min.css"));
}

// #[doc(hidden)]
pub struct BundleStyleConfig {
    pub css_dir: String,
    pub out_file: String,
    pub static_dir: String,
    pub prepend_defaults: bool,
}

// Bundle and minify the combined CSS using `lightningcss` (formerly `parcel_css`)
#[doc(hidden)]
pub fn bundle_styles_impl(config: BundleStyleConfig) {
    let css_dir = config.css_dir; // "pkg"
    let out_file = config.out_file; // "styles.min.css"
    let static_dir = config.static_dir; // "static"
    let prepend_defaults = config.prepend_defaults; // true
    let css_dir_exists = Path::new(&css_dir).is_dir();

    if css_dir_exists || prepend_defaults {
        std::fs::create_dir_all(static_dir.clone()).expect("Failed to create static/ directory");
        let output_file = format!("{}/{}", static_dir, out_file);
        let css_files: Vec<PathBuf> = if css_dir_exists {
            fs::read_dir(css_dir.clone())
                .expect(format!("Failed to read CSS directory: {}", css_dir).as_str())
                .filter_map(|entry| {
                    let entry = entry.expect("Failed to read directory entry");
                    let path = entry.path();
                    if path.extension().map_or(false, |ext| ext == "css") {
                        Some(path)
                    } else {
                        None
                    }
                })
                .collect::<Vec<_>>()
        } else {
            Vec::new()
        };
        let mut rule_sources: HashMap<String, Vec<String>> = HashMap::new();

        // Prepend default styles
        let mut pico_content = String::new();
        if prepend_defaults {
            pico_content.push_str(PICO_CSS.get_or_empty().as_str());
            // No Parsing for conflicts, as potentially there are many
        }

        for file_path in &css_files {
            let scope = file_path
                .file_stem()
                .and_then(|s| s.to_str())
                .expect("Failed to get file stem")
                .to_string();

            let css_content = fs::read_to_string(&file_path).expect("Failed to read CSS file");

            let stylesheet = StyleSheet::parse(&css_content, ParserOptions::default())
                .expect("Failed to parse CSS");

            for rule in stylesheet.rules.0 {
                if let CssRule::Style(style_rule) = rule {
                    let selector = style_rule.selectors.to_css_string(PrinterOptions {
                        minify: false,
                        ..Default::default()
                    });
                    rule_sources
                        .entry(format!("{:?}", selector))
                        .or_insert_with(Vec::new)
                        .push(scope.clone());
                }
            }
        }
        // Check for conflicts
        let mut conflicts = Vec::new();
        for (selector, sources) in &rule_sources {
            if sources.len() > 1 {
                conflicts.push(format!(
                    "Conflict detected for selector '{}' in scopes: {}",
                    selector,
                    sources.join(", ")
                ));
            }
        }
        if !conflicts.is_empty() {
            panic!("CSS conflicts detected:\n{}", conflicts.join("\n"));
        }

        let combined_css = css_files
            .into_iter()
            .map(|path| fs::read_to_string(&path).expect("Failed to read CSS file"))
            .collect::<Vec<_>>()
            .join("\n");
        let all_css = format!("{}{}", pico_content, combined_css); // Combine with dfault styles

        let stylesheet =
            StyleSheet::parse(&all_css, ParserOptions::default()).expect("Failed to parse CSS");
        let minified_css = stylesheet
            .to_css(PrinterOptions {
                minify: true,
                ..Default::default()
            })
            .expect("Failed to minify CSS")
            .code;

        let mut file = File::create(output_file.clone())
            .expect(&format!("Failed to create {}", output_file).as_str());
        file.write_all(minified_css.as_bytes())
            .expect("Failed to write minified CSS");
        if prepend_defaults {
            PICO_CSS.set_none();
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::utils::TempDir;
    use std::fs;

    #[test]
    fn test_bundle_styles_no_conflicts() {
        // Using self-dropping temporary directories for clenaup
        let temp_pkg_dir = TempDir::new("pkg_test1");
        let temp_static_dir = TempDir::new("static_test1");
        // To be dropped if empty. Useful because it is created no matter what by the implementation
        let _pkg = TempDir::may_keep("pkg");

        let pkg_dir = temp_pkg_dir
            .get_path()
            .to_str()
            .expect("Cannot get the path to temporary dir pkg/");
        let out_file = "styles1.min.css".to_string();
        let static_dir = temp_static_dir
            .get_path()
            .to_str()
            .expect("Cannot get the path to temporary static dir");

        fs::create_dir_all(pkg_dir).expect("Failed to create pkg_test1/ directory");
        fs::create_dir_all(static_dir).expect("Failed to create static_test1/ directory");

        let css1 = r#".class1 { color: red; }"#;
        let css2 = r#".class2 { color: blue; }"#;
        let css1_file = format!("{}/scope1.css", pkg_dir);
        let css2_file = format!("{}/scope2.css", pkg_dir);
        fs::write(css1_file.clone(), css1).expect("Failed to write CSS file");
        fs::write(css2_file.clone(), css2).expect("Failed to write CSS file");

        bundle_styles_impl(BundleStyleConfig {
            css_dir: pkg_dir.to_string(),
            out_file: out_file.clone(),
            static_dir: static_dir.to_string(),
            prepend_defaults: false,
        });

        let output_file = format!("{}/{}", static_dir, out_file);
        let minified_css = fs::read_to_string(output_file.clone())
            .expect("Failed to read static/styles.min.css, did the bundler fail?");

        assert!(minified_css.contains(".class1{color:red}")); // doesn't convert to color value since it is shorter
        assert!(minified_css.contains(".class2{color:#00f}")); // converts to color value
    }

    #[test]
    #[should_panic(expected = "CSS conflicts detected:")]
    fn test_bundle_styles_with_conflicts() {
        // Using self-dropping temporary directories for clenaup
        let temp_pkg_dir = TempDir::new("pkg_test2");
        let temp_static_dir = TempDir::new("static_test2");
        // To be dropped if empty. Useful because it is created no matter what by the implementation
        let _pkg = TempDir::may_keep("pkg");

        let pkg_dir = temp_pkg_dir
            .get_path()
            .to_str()
            .expect("Cannot get the path to temporary dir pkg/");
        let out_file = "styles2.min.css".to_string();
        let static_dir = temp_static_dir
            .get_path()
            .to_str()
            .expect("Cannot get the path to temporary static dir");

        fs::create_dir_all(pkg_dir).expect("Failed to create pkg_test2/ directory");
        fs::create_dir_all(static_dir).expect("Failed to create static_test2/ directory");

        let css1 = r#".button { color: red; }"#;
        let css2 = r#".button { color: blue; }"#;
        let css1_file = format!("{}/scope1.css", pkg_dir);
        let css2_file = format!("{}/scope2.css", pkg_dir);
        fs::write(css1_file.clone(), css1).expect("Failed to write CSS file");
        fs::write(css2_file.clone(), css2).expect("Failed to write CSS file");

        // Call the implementation (should panic due to conflicts)
        bundle_styles_impl(BundleStyleConfig {
            css_dir: pkg_dir.to_string(),
            out_file: out_file.clone(),
            static_dir: static_dir.to_string(),
            prepend_defaults: false,
        });
    }
}
